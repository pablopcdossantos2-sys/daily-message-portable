<Window
    x:Class="DailyMessage.MessageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Daily Message">
    <Grid RowDefinitions="*,Auto" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border Grid.Row="0" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <TextBlock x:Name="MessageTitle" FontSize="28" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="MessageBlocks" Spacing="14" />
            </StackPanel>
        </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="1" Spacing="8" Padding="0,18,0,0">
            <ProgressBar x:Name="CountdownBar" Minimum="0" Maximum="10" Value="10" />
            <TextBlock x:Name="CountdownText" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <Button x:Name="CloseButton" Content="Ok" MinWidth="130" HorizontalAlignment="Right"
                    IsEnabled="False" Click="CloseButton_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
